# 1) In Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=
# For testing without a webhook, set true (alerts print to terminal instead)
CONSOLE_ONLY=false

SYMBOLS=BTCUSDT,ETHUSDT
WINDOW_SECONDS=60
PRESSURE_THRESHOLD=0.65
MIN_TRADES=100
COOLDOWN_SECONDS=180
EVALUATION_SECONDS=10
CONFIRMATIONS=2
NEUTRAL_WINDOWS=2
MIN_CONFIRMING_FACTORS=2
MIN_VOLUME_RATIO=0.65

# Public market-data-only Binance endpoints (no API key)
BINANCE_REST_URL=https://data-api.binance.vision
BINANCE_WS_BASE=wss://data-stream.binance.vision/stream?streams=

# Dashboard only accessible on this computer unless you deliberately change this
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

# V5 research features (no exchange credentials, no real trading)
LARGE_TRADE_MIN_USDT=100000
REPLAY_RETENTION_DAYS=14

# Optional: require BOTH 5m and 15m EMA trend to agree with each signal.
# Disabled by default to preserve original V4 signal behavior.
MTF_GATE_ENABLED=false

# Smart Notifications: still save every gated research signal locally.
# Discord sends only when at least 3/4 factors pass AND a 30-minute cooldown
# per market has elapsed; suppressed signals remain in history/CSV.
DISCORD_COOLDOWN_SECONDS=1800
DISCORD_MIN_FACTORS=3

# Optional quiet signal summary every N hours. 0 = off; 1 = hourly.
# Allowed: 0,1,2,4,6,12,24.
DISCORD_SUMMARY_HOURS=0

# COOLDOWN_SECONDS above is *research signal* gating, separate from Discord.
