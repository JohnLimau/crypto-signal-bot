# 1) In Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=
# For testing without a webhook, set true (alerts print to terminal instead)
CONSOLE_ONLY=false

SYMBOLS=BTCUSDT,ETHUSDT
WINDOW_SECONDS=60
PRESSURE_THRESHOLD=0.65
MIN_TRADES=100
COOLDOWN_SECONDS=180
EVALUATION_SECONDS=10
CONFIRMATIONS=2
NEUTRAL_WINDOWS=2
MIN_CONFIRMING_FACTORS=2
MIN_VOLUME_RATIO=0.65

# Public market-data-only Binance endpoints (no API key)
BINANCE_REST_URL=https://data-api.binance.vision
BINANCE_WS_BASE=wss://data-stream.binance.vision/stream?streams=

# Dashboard only accessible on this computer unless you deliberately change this
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
